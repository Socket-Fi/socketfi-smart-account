# Ignore target directory (build output)
target/

# Ignore intermediate files produced by Cargo
**/*.rs.bk
**/*.rs~

# Ignore compiled library files
*.rlib


# Ignore IDE and editor-specific files
.idea/
.vscode/
*.swp
*.swo

# Ignore files generated by running tests
*.log

# Soroban host test snapshots and local release output
**/test_snapshots/
artifacts/
